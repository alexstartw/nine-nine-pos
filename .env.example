# 複製此檔為 .env 並填入實際值
# .env 不可提交到版本控制（已在 .gitignore）

# ── 資料庫 ────────────────────────────────────────────────────────────────────
# Dev:  Supabase dev project 的 Session pooler URL
# Prod: Supabase prod project 的 Session pooler URL
# 留空 = 使用本機 SQLite（./data/app.db）
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── JWT 驗證 ──────────────────────────────────────────────────────────────────
# 產生方式：openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret

# ── 初始管理員（僅首次啟動 seed 用，之後請在後台管理帳號）────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  http://localhost:3000,http://127.0.0.1:3000
# Prod: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 前端 ─────────────────────────────────────────────────────────────────────
# 應用程式版本（顯示於頁面 footer，與 Makefile 的 VERSION 保持一致）
NEXT_PUBLIC_APP_VERSION=2.0

# Docker build 時前端打 API 的 base URL
# Dev 留空，Prod 填 https://your-domain.com
# NEXT_PUBLIC_API_BASE_URL=

# ── Docker ────────────────────────────────────────────────────────────────────
# 對外 port（預設 8080）
# APP_PORT=8080
