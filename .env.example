# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_NAME=about-nine^2 POS API
API_PREFIX=/api
# Leave empty to use default sqlite database under ./data/app.db
DATABASE_URL=
# Comma separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex to allow additional origins (defaults to localhost/127 loopback)
CORS_ORIGIN_REGEX=

# Docker / Compose
# Host port exposed by docker-compose (defaults to 8080 when unset)
APP_PORT=8080
