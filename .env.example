# 複製此檔為 .env 並填入實際值，.env 不可提交到版本控制

# JWT 金鑰（請使用隨機長字串，例如：openssl rand -hex 32）
JWT_SECRET=replace-with-a-strong-random-secret

# 管理員帳號
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 應用程式版本（顯示於頁面 footer，與 Makefile 的 VERSION 保持一致）
NEXT_PUBLIC_APP_VERSION=2.0

# Docker 對外 port（預設 8080）
# APP_PORT=8080
